{
  "name": "bacheta-pwa",
  "version": "0.0.0",
  "description": "PWA para relevar baches, veredas rotas y derrames de agua de forma autónoma y manos libres. 100 % en el navegador.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "iconos": "node scripts/generar-iconos.mjs",
    "verificar": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "author": "rauldiazsolis",
  "license": "MIT",
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
